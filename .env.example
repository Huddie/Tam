# FMP API key (financialmodelingprep.com/developer/docs) — used by tam.data.providers.FMPProvider.
# Copy this file to .env and fill in the real value; .env is gitignored, never commit real keys.
FMP_API_KEY=

# Cloudflare R2 — used by tam.marketdata (the 1-minute market-data lake) for both
# ingestion writes and any direct Python-side reads. Query access from a notebook
# should prefer a READ-ONLY R2 API token; ingestion needs a read-write one — see
# MARKETDATA.md. Colab has no .env file: set these as Colab secrets (same names,
# via the key-icon panel) instead — see tam.marketdata.credentials.resolve_r2_credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Massive flat-files S3 credentials (from your Massive dashboard — NOT a REST
# apiKey) — used by tam.marketdata.providers.MassiveFlatFileProvider for bulk
# historical minute-bar backfills. Only ever needed wherever the ingestion job
# itself runs (local machine / CI), never from a notebook.
MASSIVE_S3_ACCESS_KEY_ID=
MASSIVE_S3_SECRET_ACCESS_KEY=
